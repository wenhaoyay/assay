# Copy to .env. Every value here is a placeholder; never commit a real key.

# Database. Default (unset): SQLite at data/gaugelab.db. Docker Compose sets Postgres itself.
# DATABASE_URL=postgresql+psycopg://gaugelab:gaugelab@localhost:5432/gaugelab

# Judge / generator keys (bring your own). GaugeLab stores only the NAME of the variable
# (a provider config references env:OPENAI_API_KEY); the value stays in this environment.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Where the seeded HTTP demo target points (Docker sets this to the demo-agent service).
# GAUGELAB_DEMO_AGENT_URL=http://127.0.0.1:9040
