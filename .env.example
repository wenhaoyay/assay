# Copy to .env. Every value here is a placeholder; never commit a real key.

# Database. Default (unset): SQLite at data/assay.db. Docker Compose sets Postgres itself.
# DATABASE_URL=postgresql+psycopg://assay:assay@localhost:5432/assay

# Judge / generator keys (bring your own). Easiest: paste the key in Settings > Models & keys,
# which stores it in the OS credential store (referenced as keyring:NAME). Or set it here and
# reference it as env:NAME. Assay stores only the reference, never the key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Where the seeded HTTP demo target points (Docker sets this to the demo-agent service).
# ASSAY_DEMO_AGENT_URL=http://127.0.0.1:9040

# Python connections may name only the demo agent and these modules (comma-separated).
# ASSAY_PYTHON_TARGETS=my_bot,my_company.bots
# Extra host names the API answers to, besides localhost and 127.0.0.1 (comma-separated).
# ASSAY_ALLOWED_HOSTS=
# Postgres password for Docker Compose (the default is for a throwaway local demo only).
# POSTGRES_PASSWORD=
